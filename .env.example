# PostgreSQL connection string used by Prisma (e.g. Prisma Postgres, Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Supabase Auth (Vite frontend + /api/sync JWT verification fallback)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# Optional server-side overrides (defaults to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY)
# NEXT_PUBLIC_SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional: Google OAuth popup flow
# VITE_GOOGLE_CLIENT_ID=""
# VITE_GOOGLE_AUTH_PROXY=""

# Optional: Auto-wake paused database on connection failure
# FULLSTACK_PROJECT_REF=""
# FULLSTACK_RESTORE_API_URL=""
